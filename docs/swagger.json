    "definitions": {
        "auth.ErrorRes400": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "bad request"
                },
                "message": {
                    "type": "string",
                    "example": "failed to process..."
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "auth.ErrorRes500": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "internal server error"
                },
                "message": {
                    "type": "string",
                    "example": "failed to process..."
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "auth.GoogleSignInReq": {
            "type": "object",
            "required": [
                "id_token"
            ],
            "properties": {
                "id_token": {
                    "type": "string"
                }
            }
        },
        "auth.GoogleSignInRes": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string",
                    "example": "xxx..."
                },
                "firstName": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "lastName": {
                    "type": "string"
                },
                "refreshToken": {
                    "type": "string",
                    "example": "yyyyyy"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "auth.RefreshTokenReq": {
            "type": "object",
            "required": [
                "refreshToken"
            ],
            "properties": {
                "refreshToken": {
                    "type": "string",
                    "example": "yyyyy..."
                }
            }
        },
        "auth.RefreshTokenRes": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string",
                    "example": "xxx..."
                },
                "refreshToken": {
                    "type": "string",
                    "example": "yyyyyy"
                }
            }
        },
        "auth.ResendOTPreq": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "haidar@gmail.com"
                }
            }
        },
        "auth.SignInReq": {
            "type": "object",
            "required": [
                "identifier",
                "password"
            ],
            "properties": {
                "identifier": {
                    "type": "string",
                    "maxLength": 320,
                    "minLength": 3,
                    "example": "haidar@gmail.com"
                },
                "password": {
                    "type": "string",
                    "maxLength": 24,
                    "minLength": 8,
                    "example": "password123"
                }
            }
        },
        "auth.SignInRes": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string",
                    "example": "xxxxx"
                },
                "refreshToken": {
                    "type": "string",
                    "example": "yyyyyy"
                }
            }
        },
        "auth.SignUpRequest": {
            "type": "object",
            "required": [
                "email",
                "firstName",
                "lastName",
                "password",
                "username"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "haidar@gmail.com"
                },
                "firstName": {
                    "type": "string",
                    "maxLength": 24,
                    "minLength": 3,
                    "example": "Haidar"
                },
                "lastName": {
                    "type": "string",
                    "maxLength": 24,
                    "minLength": 3,
                    "example": "Hanif"
                },
                "password": {
                    "type": "string",
                    "maxLength": 24,
                    "minLength": 8,
                    "example": "password123"
                },
                "username": {
                    "type": "string",
                    "maxLength": 24,
                    "minLength": 3,
                    "example": "haidarIron"
                }
            }
        },
        "auth.SignUpResponse": {
            "type": "object",
            "properties": {
                "firstName": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "isVerified": {
                    "type": "boolean"
                },
                "lastName": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "auth.VerifyOTPreq": {
            "type": "object",
            "required": [
                "email",
                "otpCode"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "haidar@gmail.com"
                },
                "otpCode": {
                    "type": "string",
                    "example": "111111"
                }
            }
        },
        "routine.CreateRoutineRequest": {
            "type": "object",
            "required": [
                "name",
                "routineExercises"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Chest, shoulders and triceps"
                },
                "isPublic": {
                    "type": "boolean",
                    "example": false
                },
                "name": {
                    "type": "string",
                    "example": "Push Day"
                },
                "routineExercises": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/routine.RoutineExercisesRequest"
                    }
                }
            }
        },
        "routine.RoutineExerciseSetRequest": {
            "type": "object",
            "required": [
                "reps",
                "setNumber",
                "weightKg"
            ],
            "properties": {
                "reps": {
                    "type": "integer",
                    "example": 10
                },
                "setNumber": {
                    "type": "integer",
                    "example": 1
                },
                "weightKg": {
                    "type": "number",
                    "example": 40
                }
            }
        },
        "routine.RoutineExercisesRequest": {
            "type": "object",
            "required": [
                "exerciseId",
                "order"
            ],
            "properties": {
                "exerciseId": {
                    "type": "integer",
                    "example": 12
                },
                "order": {
                    "type": "integer",
                    "example": 1
                },
                "restSecond": {
                    "type": "integer",
                    "example": 90
                },
                "routineExerciseSet": {
