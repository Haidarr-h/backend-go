    "definitions": {
        "controllers.ExerciseDelReq": {
            "type": "object",
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "integer"
                    }
                }
            }
        },
        "controllers.ExerciseRequest": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "equipment": {
                    "type": "string"
                },
